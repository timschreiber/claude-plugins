# Plugin and probe files are used verbatim from a git clone; keep them LF on every platform.
plugins/planandtier/** text eol=lf
plugins/decidinator/** text eol=lf
tests/decidinator/** text eol=lf
probes/planandtier/** text eol=lf
probes/decidinator/** text eol=lf
# Decidinator probe evidence is generated with LF; keep it byte-stable across platforms.
probes/evidence/decidinator-*.json text eol=lf
probes/evidence/decidinator-*.jsonl text eol=lf
# A copied tasks file must stay byte-exact so its sha256 still matches the plan's table.
probes/evidence/*.tasks.json -text
# Bash files keep LF line endings on every platform, whatever core.autocrlf
# says: bash can't run a script checked out with CRLF (D61).
*.sh eol=lf
*.bats eol=lf
*.bash eol=lf
plugins/orcastrat/scripts/** eol=lf
plugins/orcastrat/hooks/** eol=lf
tests/orcastrat/** eol=lf
scripts/run-bats.sh eol=lf
