#!/usr/bin/env bash
# suggest-check <plan-dir>
#
# Prints one line `<category> <milestone IDs>` for each finding category
# used, in D182's shapes, by the milestone reviews (`notes/M<nn>-review*.md`)
# or per-task reviews (`notes/reviews/M<nn>-T*.md`) of two or more
# milestones, that isn't already a `## <category>` heading in
# `notes/instruction-suggestions.md`. Plan reviews (`notes/M<nn>-plan-review.md`)
# never count. Prints `OK` when there is no such category. Lines are printed
# in `LC_ALL=C sort` order (D213).
# Exits 0 after printing. On a usage error, or when <plan-dir> isn't a
# directory or git work tree, prints one `error: <message>` line on stderr,
# nothing on stdout, and exits 2 (D55).
# Bash 3.2 compatible.

# shellcheck source=/dev/null
. "$(dirname "${BASH_SOURCE[0]}")/lib/common"

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 2
}

if [ "$#" -ne 1 ]; then
  fail 'usage: suggest-check <plan-dir>'
fi
plan_dir=$1

[ -d "$plan_dir" ] || fail "not a directory: $(print_path "$plan_dir")"
[ "$(git -C "$plan_dir" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] ||
  fail "not inside a git work tree: $(print_path "$plan_dir")"

# Prints `<category> <milestone>` for each scored-finding line in the given
# file, carriage returns stripped.
# shellcheck disable=SC2016
findings_awk='
{
  sub(/\r$/, "")
  line = $0
  if (line ~ /^- \[[0-9]+(\/([0-9]+|none))?\] [a-z0-9][a-z0-9-]*: /) {
    rest = line
    sub(/^- \[[0-9]+(\/([0-9]+|none))?\] /, "", rest)
    colon = index(rest, ": ")
    category = substr(rest, 1, colon - 1)
    print category " " milestone
  }
}'

pairs=$(
  for f in "$plan_dir"/notes/M*-review*.md; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    printf '%s\n' "$base" | grep -Eq '^M[0-9]+-review(-[0-9]+)?\.md$' || continue
    milestone=${base%%-*}
    awk -v milestone="$milestone" "$findings_awk" "$f"
  done
  for f in "$plan_dir"/notes/reviews/M*-T*.md; do
    [ -f "$f" ] || continue
    base=$(basename "$f")
    milestone=${base%%-T*}
    printf '%s\n' "$milestone" | grep -Eq '^M[0-9]+$' || continue
    awk -v milestone="$milestone" "$findings_awk" "$f"
  done
)

suggested=""
if [ -f "$plan_dir/notes/instruction-suggestions.md" ]; then
  # shellcheck disable=SC2016
  suggested=$(awk '
    {
      sub(/\r$/, "")
      line = $0
      t = line
      sub(/^[ \t]*/, "", t)
      is_fence_marker = (t ~ /^(```|~~~)/)
      if (fence_open != "") {
        if (is_fence_marker) fence_open = ""
      } else if (is_fence_marker) {
        fence_open = "1"
      } else if (line ~ /^## /) {
        print substr(line, 4)
      }
    }
  ' "$plan_dir/notes/instruction-suggestions.md")
fi

printf '%s\n' "$pairs" |
  LC_ALL=C sort -u |
  awk -v suggested="$suggested" '
    BEGIN {
      n = split(suggested, s, "\n")
      for (i = 1; i <= n; i++) already[s[i]] = 1
    }
    NF >= 2 {
      category = $1
      milestone = $2
      if (!(category in count)) {
        count[category] = 0
        order[++k] = category
      }
      count[category]++
      milestones[category] = milestones[category] " " milestone
    }
    END {
      printed = 0
      for (i = 1; i <= k; i++) {
        category = order[i]
        if (count[category] < 2) continue
        if (category in already) continue
        n2 = split(milestones[category], m, " ")
        delete seen
        line = category
        for (j = 1; j <= n2; j++) {
          if (m[j] == "" || (m[j] in seen)) continue
          seen[m[j]] = 1
          line = line " " m[j]
        }
        print line
        printed = 1
      }
      if (!printed) print "OK"
    }
  '

exit 0
