#!/usr/bin/env bash
# next <plan-dir>
#
# Prints the run's current position as six `key: value` lines, reading only
# plan.md's header, Milestones table and Open questions, and each milestone
# file's task Status, Wave and Tier lines (never Decisions, Context, Steps or
# notes):
#   plan: <status>
#   milestone: <ID> <status> <file>, for the first Milestones-table row whose
#     status isn't done, or milestone: none when every row is done
#   next: <step>, the first of these that applies: plan status complete ->
#     complete; plan status blocked, or any milestone or task blocked ->
#     blocked; no current milestone -> final-verify; current status outline
#     -> detail <ID> when notes/<ID>-survey.md is tracked by git, else
#     survey <ID>; ready -> start <ID>; the current milestone has a todo
#     task -> wave <n>, with <n> from the wave: line; otherwise
#     review <ID> when notes/<ID>-review.md is tracked, else
#     milestone-verify <ID>
#   wave: <n> <task ID>:<tier> ... for the lowest wave (compared as a
#     number) among the current milestone's todo tasks whose wave is a
#     positive integer, or wave: none
#   blocked: <IDs>, for each Milestones-table row in table order, its ID
#     when its status is blocked, then the ID of each task in its file with
#     status blocked, in file order, or blocked: none
#   open-questions: <count> of lines starting "- " under "## Open questions"
#   recover: <plan-dir>'s recover output lines, joined by "; "
#   worktrees: <count> of leftover task worktrees under the plan's worktree
#     root (directories directly under it that hold a .git file)
#   marker: none | active <heartbeat age in minutes>m | stale, read from
#     the plan checkout's own git dir's orcastrat/active-run file; stale
#     when the heartbeat is unreadable or more than 3600 seconds old
# Paths go through print_path. Task headings and their Status, Wave and Tier
# lines inside fenced code blocks are ignored (recover's fence rule), and
# CRLF line endings are accepted. Every line is computed before any is
# printed, so an error prints nothing on stdout.
# Exits 0 after printing its result. On a usage error, prints one
# `error: <message>` line on stderr, nothing on stdout, and exits 2 (D55).
# Bash 3.2 compatible.

# shellcheck source=/dev/null
. "$(dirname "${BASH_SOURCE[0]}")/lib/common"

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 2
}

if [ "$#" -ne 1 ]; then
  fail 'usage: next <plan-dir>'
fi
plan_dir=$1

[ -d "$plan_dir" ] || fail "not a directory: $(print_path "$plan_dir")"
[ "$(git -C "$plan_dir" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] ||
  fail "not inside a git work tree: $(print_path "$plan_dir")"
[ -f "$plan_dir/plan.md" ] || fail "no plan.md in: $(print_path "$plan_dir")"

recover_out=$(bash "$(dirname "${BASH_SOURCE[0]}")/recover" "$plan_dir")
recover_status=$?
[ "$recover_status" -eq 0 ] || fail 'recover failed'
recover_line=$(printf '%s\n' "$recover_out" | awk '{ a[NR] = $0 } END { for (i = 1; i <= NR; i++) { printf "%s%s", (i > 1 ? "; " : ""), a[i] } }')

# Prints the value of the first `- Status:` line above plan.md's first line
# starting `## `.
# shellcheck disable=SC2016
plan_status_awk='
{ sub(/\r$/, "") }
/^## / { exit }
!found && /^- Status:/ {
  v = $0
  sub(/^- Status:[ \t]*/, "", v)
  sub(/[ \t]*$/, "", v)
  print v
  found = 1
}'
plan_status=$(awk "$plan_status_awk" "$plan_dir/plan.md")

# Prints "<ID>\t<status>\t<file>" for each Milestones-table row whose first
# cell matches ^M[0-9]+$, in table order. The file is the last non-empty
# cell, and the status the cell before it.
# shellcheck disable=SC2016
milestones_awk='
{ sub(/\r$/, "") }
/^## / { in_table = ($0 == "## Milestones"); next }
in_table && /^\|/ {
  n = split($0, cell, "|")
  for (i = 1; i <= n; i++) gsub(/^[ \t]+|[ \t]+$/, "", cell[i])
  id = cell[2]
  if (id !~ /^M[0-9]+$/) next
  fi = n
  file = cell[fi]
  if (file == "") { fi = n - 1; file = cell[fi] }
  status = cell[fi - 1]
  printf "%s\t%s\t%s\n", id, status, file
}'
milestone_rows=$(awk "$milestones_awk" "$plan_dir/plan.md")

# Prints "<ID>\t<status>\t<wave>\t<tier>" for each task heading
# (^### M<n>-T<n>:) outside a code fence (recover's fence rule), in file
# order. The status, wave and tier are the values of the task's first
# `- Status:`, `- Wave:` and `- Tier:` lines, trimmed.
# shellcheck disable=SC2016
tasks_awk='
function fence_of(s,   c, n) {
  c = substr(s, 1, 1)
  if (c != "`" && c != "~") return ""
  n = 0
  while (substr(s, n + 1, 1) == c) n++
  if (n < 3) return ""
  return substr(s, 1, n)
}
function emit() {
  if (id != "") printf "%s\t%s\t%s\t%s\n", id, status, wave, tier
}
{
  sub(/\r$/, "")
  t = $0
  sub(/^[ \t]*/, "", t)
  f = fence_of(t)
  if (fence_open != "") {
    rest = substr(t, length(f) + 1)
    sub(/[ \t]*$/, "", rest)
    if (f != "" && substr(f, 1, 1) == substr(fence_open, 1, 1) && length(f) >= length(fence_open) && rest == "") fence_open = ""
    next
  }
  if (f != "") { fence_open = f; next }
  if ($0 ~ /^#+ /) {
    emit()
    id = ""; status = ""; wave = ""; tier = ""
    status_seen = 0; wave_seen = 0; tier_seen = 0
    if ($0 ~ /^### M[0-9]+-T[0-9]+:/) {
      id = substr($0, 5)
      sub(/:.*/, "", id)
    }
    next
  }
  if (id == "") next
  if (!status_seen && $0 ~ /^- Status:/) {
    status_seen = 1
    v = $0; sub(/^- Status:[ \t]*/, "", v); sub(/[ \t]*$/, "", v); status = v
  }
  if (!wave_seen && $0 ~ /^- Wave:/) {
    wave_seen = 1
    v = $0; sub(/^- Wave:[ \t]*/, "", v); sub(/[ \t]*$/, "", v); wave = v
  }
  if (!tier_seen && $0 ~ /^- Tier:/) {
    tier_seen = 1
    v = $0; sub(/^- Tier:[ \t]*/, "", v); sub(/[ \t]*$/, "", v); tier = v
  }
}
END { emit() }'

# Prints the number of lines starting "- " under "## Open questions".
# shellcheck disable=SC2016
open_questions_awk='
{ sub(/\r$/, "") }
/^## / { in_oq = ($0 == "## Open questions"); next }
in_oq && /^- / { count++ }
END { print count + 0 }'
open_questions=$(awk "$open_questions_awk" "$plan_dir/plan.md")

# The current milestone: the first Milestones-table row whose status isn't
# done.
current_id=
current_status=
current_file=
while IFS=$'\t' read -r id status file; do
  [ -n "$id" ] || continue
  if [ -z "$current_id" ] && [ "$status" != done ]; then
    current_id=$id
    current_status=$status
    current_file=$file
  fi
done <<<"$milestone_rows"

# blocked: each blocked Milestones-table row, then each blocked task of its
# file, in table order then file order.
blocked_ids=
while IFS=$'\t' read -r id status file; do
  [ -n "$id" ] || continue
  if [ "$status" = blocked ]; then
    blocked_ids="$blocked_ids${blocked_ids:+ }$id"
  fi
  if [ -n "$file" ] && [ -f "$plan_dir/$file" ]; then
    while IFS=$'\t' read -r tid tstatus twave ttier; do
      [ -n "$tid" ] || continue
      if [ "$tstatus" = blocked ]; then
        blocked_ids="$blocked_ids${blocked_ids:+ }$tid"
      fi
    done <<<"$(awk "$tasks_awk" "$plan_dir/$file")"
  fi
done <<<"$milestone_rows"

# wave: the lowest wave (as a number) among the current milestone's todo
# tasks whose wave is a positive integer, and those tasks' IDs and tiers.
wave_line='wave: none'
has_todo=0
if [ -n "$current_id" ] && [ -n "$current_file" ] && [ -f "$plan_dir/$current_file" ]; then
  current_tasks=$(awk "$tasks_awk" "$plan_dir/$current_file")
  min_wave=
  while IFS=$'\t' read -r tid tstatus twave ttier; do
    [ -n "$tid" ] || continue
    [ "$tstatus" = todo ] || continue
    has_todo=1
    case "$twave" in
      '' | *[!0-9]*) continue ;;
    esac
    [ "$twave" -gt 0 ] || continue
    if [ -z "$min_wave" ] || [ "$twave" -lt "$min_wave" ]; then
      min_wave=$twave
    fi
  done <<<"$current_tasks"
  if [ -n "$min_wave" ]; then
    wave_tasks=
    while IFS=$'\t' read -r tid tstatus twave ttier; do
      [ -n "$tid" ] || continue
      [ "$tstatus" = todo ] || continue
      [ "$twave" = "$min_wave" ] || continue
      wave_tasks="$wave_tasks${wave_tasks:+ }$tid:$ttier"
    done <<<"$current_tasks"
    wave_line="wave: $min_wave $wave_tasks"
  fi
fi
wave_n=$(printf '%s\n' "$wave_line" | awk '{print $2}')

# worktrees: the number of directories directly under WT_ROOT that hold a
# .git file, where WT_ROOT is <common>/orcastrat/<slug> (verify's slug and
# common-dir resolution, with <plan-dir> in place of <dir>).
slug=$(printf '%s\n' "$plan_dir" | sed -e 's#\\#/#g' -e 's#/*$##' -e 's#.*/##')
common=$(git -C "$plan_dir" rev-parse --git-common-dir)
common_abs=$(cd "$plan_dir" && cd "$common" && pwd) ||
  fail "cannot resolve the git common dir of: $(print_path "$plan_dir")"
wt_root="$common_abs/orcastrat/$slug"
worktree_count=0
if [ -d "$wt_root" ]; then
  for entry in "$wt_root"/*; do
    [ -d "$entry" ] || continue
    [ -f "$entry/.git" ] || continue
    worktree_count=$((worktree_count + 1))
  done
fi

# marker: read from the plan checkout's own git dir.
plan_git_dir=$(git -C "$plan_dir" rev-parse --git-dir)
plan_git_dir_abs=$(cd "$plan_dir" && cd "$plan_git_dir" && pwd) ||
  fail "cannot resolve the git dir of: $(print_path "$plan_dir")"
marker_file="$plan_git_dir_abs/orcastrat/active-run"
if [ ! -f "$marker_file" ]; then
  marker_line='none'
else
  heartbeat=$(sed -n 's/^heartbeat=//p' "$marker_file" | head -n 1 | tr -d '\r')
  case "$heartbeat" in
    '' | *[!0-9]*)
      marker_line='stale'
      ;;
    *)
      now=$(date -u +%s)
      age=$((now - heartbeat))
      [ "$age" -ge 0 ] || age=0
      if [ "$age" -gt 3600 ]; then
        marker_line='stale'
      else
        marker_line="active $((age / 60))m"
      fi
      ;;
  esac
fi

# next: the first applicable step.
if [ "$plan_status" = complete ]; then
  next_step=complete
elif [ "$plan_status" = blocked ] || [ -n "$blocked_ids" ]; then
  next_step=blocked
elif [ -z "$current_id" ]; then
  next_step=final-verify
elif [ "$current_status" = outline ]; then
  if git -C "$plan_dir" ls-files --error-unmatch -- "notes/$current_id-survey.md" >/dev/null 2>&1; then
    next_step="detail $current_id"
  else
    next_step="survey $current_id"
  fi
elif [ "$current_status" = ready ]; then
  next_step="start $current_id"
elif [ "$has_todo" = 1 ]; then
  next_step="wave $wave_n"
else
  if git -C "$plan_dir" ls-files --error-unmatch -- "notes/$current_id-review.md" >/dev/null 2>&1; then
    next_step="review $current_id"
  else
    next_step="milestone-verify $current_id"
  fi
fi

printf 'plan: %s\n' "$plan_status"
if [ -n "$current_id" ]; then
  printf 'milestone: %s %s %s\n' "$current_id" "$current_status" "$(print_path "$plan_dir/$current_file")"
else
  printf 'milestone: none\n'
fi
printf 'next: %s\n' "$next_step"
printf '%s\n' "$wave_line"
printf 'blocked: %s\n' "${blocked_ids:-none}"
printf 'open-questions: %s\n' "$open_questions"
printf 'recover: %s\n' "$recover_line"
printf 'worktrees: %s\n' "$worktree_count"
printf 'marker: %s\n' "$marker_line"
exit 0
