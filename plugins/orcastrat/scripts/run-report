#!/usr/bin/env bash
# run-report <plan-dir>
#
# Writes <plan-dir>/notes/run-report.md from notes/run-log.md, plan.md's
# "- D<nn>:" lines, the milestone files named in plan.md's Milestones table,
# notes/<task ID>-failures.md failure logs, the review notes
# (notes/M*-review*.md, notes/reviews/M*.md), the trailer commits
# (Orcastrat-Task: / Orchestratinator-Task:) on the plan's Branch, and
# notes/instruction-suggestions.md. One section per run invocation (a
# `start` line through the next `end` line, or the next `start`, or the end
# of the log) and a Plan so far section, each giving tasks done,
# attempts/resumes/escalations per tier, tasks that ended STUCK, merges,
# containment downgrades, auto-decided questions, review findings per
# milestone, leftover-background-work warnings, the stops and pauses by
# reason and the wall-clock time in whole minutes, rounded down, followed by
# Usage, Model notices and Suggestions sections.
# Prints the report's absolute path through print_path, and nothing else, on
# success.
# Exits 0 after writing the report. On a usage error, prints one
# `error: <message>` line on stderr, nothing on stdout, and exits 2 (D55).
# Bash 3.2 compatible.

# shellcheck source=/dev/null
. "$(dirname "${BASH_SOURCE[0]}")/lib/common"

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 2
}

if [ "$#" -ne 1 ]; then
  fail 'usage: run-report <plan-dir>'
fi
plan_dir=$1

[ -d "$plan_dir" ] || fail "not a directory: $(print_path "$plan_dir")"
[ "$(git -C "$plan_dir" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] ||
  fail "not inside a git work tree: $(print_path "$plan_dir")"
[ -f "$plan_dir/plan.md" ] || fail "no plan.md in: $(print_path "$plan_dir")"

# branch/ref/has_ref: as recover computes them (recover:98-99), used by
# commit_records to read trailer commits on the plan's Branch.
branch=$(sed -n 's/^- Branch:[[:space:]]*//p' "$plan_dir/plan.md" 2>/dev/null | head -n 1 | tr -d '\r' | sed 's/[[:space:]]*$//')
ref="refs/heads/$branch"
if [ -n "$branch" ] && git -C "$plan_dir" rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
  has_ref=1
else
  has_ref=0
fi

# The report's title: the text after "# Plan: " on plan.md's first line when
# it starts with that, otherwise the plan directory's last path component
# (task-brief's slug= line).
first_line=$(sed -n '1p' "$plan_dir/plan.md")
first_line=${first_line%$'\r'}
case "$first_line" in
  '# Plan: '*)
    title=${first_line#'# Plan: '}
    ;;
  *)
    title=$(printf '%s\n' "$plan_dir" | sed -e 's#\\#/#g' -e 's#/*$##' -e 's#.*/##')
    ;;
esac

# runlog_records: prints "L<TAB><line>" for each line of notes/run-log.md,
# in file order, carriage returns removed. Nothing when the file doesn't
# exist.
runlog_records() {
  [ -f "$plan_dir/notes/run-log.md" ] || return 0
  sed 's/\r$//' "$plan_dir/notes/run-log.md" | awk '{ printf "L\t%s\n", $0 }'
}

# decision_records: prints "D<TAB><line without its leading \"- \">" for
# each line of plan.md, carriage return removed, that matches
# "^- D[0-9]+:".
decision_records() {
  sed 's/\r$//' "$plan_dir/plan.md" | awk '
    /^- D[0-9]+:/ { printf "D\t%s\n", substr($0, 3) }
  '
}

# task_records: for each Milestones-table row of plan.md whose ID matches
# ^M[0-9]+$, in table order, when the row's file exists, prints
# "T<TAB><task ID><TAB><status><TAB><current tier>" at each task heading's
# (### M<n>-T<n>:) end -- the next heading outside a fence, or the end of
# the file. Only lines outside fences, starting at column 0, count. The
# current tier follows D84: the starting tier is the word after "-> " in
# the task's first "- Re-tiered:" line, or else its first "- Tier:" value;
# the counted "- Escalated:" lines are those after its last "- Blocked:"
# line, or all of them when it has none; the current tier is the word
# after "-> " in the last counted "- Escalated:" line, or else the
# starting tier. Mirrors recover's fence rule (recover:55-96), as the
# copies in task-brief and next do (D211).
task_records() {
  # shellcheck disable=SC2016
  local rows_awk='
    { sub(/\r$/, "") }
    /^## / { in_table = ($0 == "## Milestones"); next }
    in_table && /^\|/ {
      n = split($0, cell, "|")
      for (i = 1; i <= n; i++) gsub(/^[ \t]+|[ \t]+$/, "", cell[i])
      id = cell[2]
      if (id !~ /^M[0-9]+$/) next
      fi = n
      file = cell[fi]
      if (file == "") { fi = n - 1; file = cell[fi] }
      if (file != "") print file
    }'
  # shellcheck disable=SC2016
  local task_awk='
    function fence_of(s,   c, n) {
      c = substr(s, 1, 1)
      if (c != "`" && c != "~") return ""
      n = 0
      while (substr(s, n + 1, 1) == c) n++
      if (n < 3) return ""
      return substr(s, 1, n)
    }
    function arrow_word(s,   pos, rest, sp) {
      pos = index(s, "→ ")
      if (pos == 0) return ""
      rest = substr(s, pos + length("→ "))
      sp = index(rest, " ")
      if (sp == 0) return rest
      return substr(rest, 1, sp - 1)
    }
    function emit(   start_tier, cur_tier, cstart) {
      if (id == "") return
      start_tier = retier_seen ? retier_to : tier_val
      cstart = blocked_seen ? (last_blocked_esc + 1) : 1
      if (esc_n >= cstart) { cur_tier = esc_to[esc_n] } else { cur_tier = start_tier }
      printf "T\t%s\t%s\t%s\n", id, status, cur_tier
    }
    {
      sub(/\r$/, "")
      t = $0
      sub(/^[ \t]*/, "", t)
      f = fence_of(t)
      if (fence_open != "") {
        rest2 = substr(t, length(f) + 1)
        sub(/[ \t]*$/, "", rest2)
        if (f != "" && substr(f, 1, 1) == substr(fence_open, 1, 1) && length(f) >= length(fence_open) && rest2 == "") fence_open = ""
        next
      }
      if (f != "") { fence_open = f; next }
      if ($0 ~ /^#+ /) {
        emit()
        id = ""; status = ""; status_seen = 0
        tier_val = ""; tier_seen = 0
        retier_to = ""; retier_seen = 0
        blocked_seen = 0; last_blocked_esc = 0
        esc_n = 0
        delete esc_to
        if ($0 ~ /^### M[0-9]+-T[0-9]+:/) {
          id = substr($0, 5)
          sub(/:.*/, "", id)
        }
        next
      }
      if (id == "") next
      if (!status_seen && $0 ~ /^- Status:/) {
        status_seen = 1
        v = $0; sub(/^- Status:[ \t]*/, "", v); sub(/[ \t]*$/, "", v); status = v
      }
      if (!tier_seen && $0 ~ /^- Tier:/) {
        tier_seen = 1
        v = $0; sub(/^- Tier:[ \t]*/, "", v); sub(/[ \t]*$/, "", v); tier_val = v
      }
      if (!retier_seen && $0 ~ /^- Re-tiered:/) {
        retier_seen = 1
        v = $0; sub(/^- Re-tiered:[ \t]*/, "", v); sub(/[ \t]*$/, "", v)
        retier_to = arrow_word(v)
      }
      if ($0 ~ /^- Escalated:/) {
        v = $0; sub(/^- Escalated:[ \t]*/, "", v); sub(/[ \t]*$/, "", v)
        esc_n++
        esc_to[esc_n] = arrow_word(v)
      }
      if ($0 ~ /^- Blocked:/) {
        blocked_seen = 1
        last_blocked_esc = esc_n
      }
    }
    END { emit() }'
  local mfile
  awk "$rows_awk" "$plan_dir/plan.md" | while IFS= read -r mfile; do
    [ -n "$mfile" ] || continue
    [ -f "$plan_dir/$mfile" ] || continue
    awk "$task_awk" "$plan_dir/$mfile"
  done
}

# commit_records: when has_ref is 1, prints
# "C<TAB><committer epoch><TAB><task ID>" for each message line, carriage
# return removed, that matches "^(Orcastrat|Orchestratinator)-Task: ", the
# task ID being the rest of the line, trimmed, and the epoch the number on
# the last line before it that starts with the byte \001.
commit_records() {
  [ "$has_ref" = 1 ] || return 0
  git -C "$plan_dir" log "$ref" -E --grep='^(Orcastrat|Orchestratinator)-Task: ' --format='%x01%ct%n%B' 2>/dev/null | awk '
    { sub(/\r$/, "") }
    /^\001/ { epoch = substr($0, 2); next }
    /^(Orcastrat|Orchestratinator)-Task: / {
      v = $0
      sub(/^(Orcastrat|Orchestratinator)-Task:[ \t]*/, "", v)
      sub(/[ \t]*$/, "", v)
      printf "C\t%s\t%s\n", epoch, v
    }
  '
}

# failure_records: for each existing file notes/M*-failures.md, in glob
# order, the task ID is its base name without "-failures.md"; for each
# "## Attempt " entry it prints, at the entry's end (the next "## " line, or
# the end of the file), "F<TAB><Time><TAB><task ID><TAB><Tier><TAB><Then>",
# the three values taken from the entry's first "- Time: ", "- Tier: " and
# "- Then: " lines, trimmed, carriage returns removed, empty when missing.
failure_records() {
  local f base task_id
  for f in "$plan_dir"/notes/M*-failures.md; do
    [ -f "$f" ] || continue
    base=$(printf '%s\n' "$f" | sed 's#.*/##')
    task_id=${base%-failures.md}
    sed 's/\r$//' "$f" | awk -v tid="$task_id" '
      function emit() {
        if (started) printf "F\t%s\t%s\t%s\t%s\n", time_v, tid, tier_v, then_v
      }
      /^## Attempt / {
        emit()
        started = 1
        time_v = ""; time_seen = 0
        tier_v = ""; tier_seen = 0
        then_v = ""; then_seen = 0
        next
      }
      /^## / {
        emit()
        started = 0
        next
      }
      started && !time_seen && /^- Time:/ {
        time_seen = 1
        v = $0; sub(/^- Time:[ \t]*/, "", v); sub(/[ \t]*$/, "", v); time_v = v
      }
      started && !tier_seen && /^- Tier:/ {
        tier_seen = 1
        v = $0; sub(/^- Tier:[ \t]*/, "", v); sub(/[ \t]*$/, "", v); tier_v = v
      }
      started && !then_seen && /^- Then:/ {
        then_seen = 1
        v = $0; sub(/^- Then:[ \t]*/, "", v); sub(/[ \t]*$/, "", v); then_v = v
      }
      END { emit() }
    '
  done
}

# review_records: for each existing file notes/M*-review*.md and
# notes/reviews/M*.md, in that glob order, prints
# "R<TAB><added epoch or empty><TAB><milestone><TAB><advisory><TAB><confirmed><TAB><downgraded>",
# counting only D182-shaped finding lines. The added epoch is the epoch of
# the oldest commit on the plan's Branch that added the file
# (--diff-filter=A), empty when has_ref is 0 or the file was never
# committed.
review_records() {
  local added=""
  if [ "$has_ref" = 1 ]; then
    added=$(git -C "$plan_dir" log "$ref" --diff-filter=A --relative --name-only --format='%x01%ct' -- notes 2>/dev/null | awk '
      /^\001/ { epoch = substr($0, 2); next }
      $0 == "" { next }
      { added[$0] = epoch }
      END { for (p in added) printf "%s\t%s\n", p, added[p] }
    ')
  fi
  (
    cd "$plan_dir" 2>/dev/null || exit 0
    local files=() f
    for f in notes/M*-review*.md; do
      [ -f "$f" ] && files+=("$f")
    done
    for f in notes/reviews/M*.md; do
      [ -f "$f" ] && files+=("$f")
    done
    [ "${#files[@]}" -eq 0 ] && exit 0
    awk -v added="$added" '
      BEGIN {
        an = split(added, aline, "\n")
        for (ai = 1; ai <= an; ai++) {
          if (aline[ai] == "") continue
          split(aline[ai], akv, "\t")
          added_epoch[akv[1]] = akv[2]
        }
      }
      function emit() {
        if (fname == "") return
        e = (fname in added_epoch) ? added_epoch[fname] : ""
        printf "R\t%s\t%s\t%s\t%s\t%s\n", e, milestone, advisory, confirmed, downgraded
      }
      FNR == 1 {
        emit()
        fname = FILENAME
        base = fname
        sub(/^.*\//, "", base)
        milestone = base
        match(milestone, /^M[0-9]+/)
        milestone = substr(milestone, RSTART, RLENGTH)
        in_blocking = 0
        in_advisory = 0
        advisory = 0
        confirmed = 0
        downgraded = 0
      }
      { sub(/\r$/, "") }
      /^## / {
        if ($0 == "## Blocking" || $0 == "## Issues") { in_blocking = 1; in_advisory = 0; next }
        if ($0 == "## Advisory") { in_advisory = 1; in_blocking = 0; next }
        in_blocking = 0
        in_advisory = 0
        next
      }
      in_blocking && $0 ~ /^(- |[0-9]+\. )\[[0-9]+(\/([0-9]+|none))?\] [a-z0-9][a-z0-9-]*: / {
        if ($0 ~ /^(- |[0-9]+\. )\[[0-9]+\/[0-9]+\] /) confirmed++
      }
      in_advisory && $0 ~ /^(- |[0-9]+\. )\[[0-9]+(\/([0-9]+|none))?\] [a-z0-9][a-z0-9-]*: / {
        advisory++
        if (index($0, " — validator: ") > 0) downgraded++
      }
      END { emit() }
    ' "${files[@]}"
  )
}

# suggestion_records: when notes/instruction-suggestions.md exists, prints
# "S<TAB><category><TAB><kind><TAB><target>" for each "## <category>"
# heading outside a fence, at the suggestion's end (the next "## " line
# outside a fence, or the end of the file), the kind and target being the
# values after the first "- Kind: " and "- Target: " lines inside it,
# trimmed, empty when missing.
suggestion_records() {
  local f="$plan_dir/notes/instruction-suggestions.md"
  [ -f "$f" ] || return 0
  sed 's/\r$//' "$f" | awk '
    function emit() {
      if (started) printf "S\t%s\t%s\t%s\n", category, kind, target
    }
    {
      t = $0
      sub(/^[ \t]*/, "", t)
      if (substr(t, 1, 3) == "```") {
        if (fence_open) { fence_open = 0 } else { fence_open = 1 }
        next
      }
    }
    fence_open { next }
    /^## / {
      emit()
      started = 1
      category = substr($0, 4)
      kind = ""; kind_seen = 0
      target = ""; target_seen = 0
      next
    }
    started && !kind_seen && /^- Kind:/ {
      kind_seen = 1
      v = $0; sub(/^- Kind:[ \t]*/, "", v); sub(/[ \t]*$/, "", v); kind = v
    }
    started && !target_seen && /^- Target:/ {
      target_seen = 1
      v = $0; sub(/^- Target:[ \t]*/, "", v); sub(/[ \t]*$/, "", v); target = v
    }
    END { emit() }
  '
}

# Sources: notes/run-log.md, plan.md's "- D<nn>:" lines, the milestone
# files, the failure logs, the review notes, the trailer commits on the
# plan's Branch, and notes/instruction-suggestions.md.
records=$(runlog_records; decision_records; task_records; commit_records; failure_records; review_records; suggestion_records)

# report_awk builds the report from the record lines above, one
# <kind><TAB><fields> per line. It ignores lines whose kind it doesn't know,
# including an empty line.
# shellcheck disable=SC2016
report_awk='
function epoch(ts,    y, m, d, h, mi, s, days) {
  if (ts !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$/) return -1
  y = substr(ts, 1, 4) + 0
  m = substr(ts, 6, 2) + 0
  d = substr(ts, 9, 2) + 0
  h = substr(ts, 12, 2) + 0
  mi = substr(ts, 15, 2) + 0
  s = substr(ts, 18, 2) + 0
  if (m <= 2) { y -= 1; m += 12 }
  days = 365*y + int(y/4) - int(y/100) + int(y/400) + int((153*(m-3)+2)/5) + d - 719469
  return days*86400 + h*3600 + mi*60 + s
}
function inv_of(t,    k) {
  if (t < 0) return 0
  for (k = 1; k <= n; k++) {
    if (inv_s[k] <= t) {
      if (inv_has_end[k]) {
        if (t <= inv_e[k]) return k
      } else if (k < n) {
        if (t < inv_s[k + 1]) return k
      } else {
        return k
      }
    }
  }
  return 0
}
function tier_list(cnt, ord, ocnt,    canon, i, j, t, list, done) {
  split("worker-mini worker-light worker worker-heavy specialist", canon, " ")
  list = ""
  for (i = 1; i <= 5; i++) {
    t = canon[i]
    if ((t in cnt) && cnt[t] > 0) {
      list = list (list == "" ? "" : ", ") t " " sprintf("%.0f", cnt[t])
      done[t] = 1
    }
  }
  for (j = 1; j <= ocnt; j++) {
    t = ord[j]
    if (t in done) continue
    if (!(t in cnt) || cnt[t] <= 0) continue
    list = list (list == "" ? "" : ", ") t " " sprintf("%.0f", cnt[t])
    done[t] = 1
  }
  if (list == "") return "none"
  return list
}
function milestone_num(mid,   s) {
  s = mid
  sub(/^M/, "", s)
  return s + 0
}
function bullets(k,    i, list, val, key, count, order, ocount, sum, any_end, j,
    r, m, a, f, cdown, acnt, wcnt, lk, w2, autoord, warnord, qid, did, txt,
    tdone_n, tdone_ids, tdone_seen, tid, tt,
    attempts_cnt, attempts_ord, attempts_ocnt,
    resumes_cnt, resumes_ord, resumes_ocnt,
    esc_cnt, esc_ord, esc_ocnt,
    stuck_n, stuck_ids, then_val, ln, suffix, stuck_list,
    rf_adv, rf_conf, rf_down, rf_seen, rf_ord, rf_ordn, rf_mid, rf_any,
    rf_lines, rf_j, rf_keyv, rf_keyn) {
  r = 0
  m = 0
  a = 0
  cdown = 0
  acnt = 0
  wcnt = 0
  tdone_n = 0
  attempts_ocnt = 0
  resumes_ocnt = 0
  esc_ocnt = 0
  stuck_n = 0
  if (k > 0) {
    for (i = 1; i <= commit_n; i++) {
      if (inv_of(commit_epoch[i]) != k) continue
      tid = commit_task[i]
      if (tid in tdone_seen) continue
      tdone_seen[tid] = 1
      tdone_n++
      tdone_ids[tdone_n] = tid
    }
  } else {
    for (i = 1; i <= task_n; i++) {
      tid = task_id_ord[i]
      if (task_status[tid] != "done") continue
      tdone_n++
      tdone_ids[tdone_n] = tid
    }
  }
  for (i = 1; i <= fail_n; i++) {
    if (k > 0 && inv_of(epoch(fail_time[i])) != k) continue
    if (fail_tier[i] != "") {
      if (!(fail_tier[i] in attempts_cnt)) {
        attempts_ocnt++
        attempts_ord[attempts_ocnt] = fail_tier[i]
        attempts_cnt[fail_tier[i]] = 0
      }
      attempts_cnt[fail_tier[i]]++
      if (fail_then[i] == "resumed") {
        if (!(fail_tier[i] in resumes_cnt)) {
          resumes_ocnt++
          resumes_ord[resumes_ocnt] = fail_tier[i]
          resumes_cnt[fail_tier[i]] = 0
        }
        resumes_cnt[fail_tier[i]]++
      }
      if (index(fail_then[i], "escalated to") > 0) {
        if (!(fail_tier[i] in esc_cnt)) {
          esc_ocnt++
          esc_ord[esc_ocnt] = fail_tier[i]
          esc_cnt[fail_tier[i]] = 0
        }
        esc_cnt[fail_tier[i]]++
      }
    }
    then_val = fail_then[i]
    suffix = "blocked (STUCK)"
    ln = length(then_val)
    if (ln >= length(suffix) && substr(then_val, ln - length(suffix) + 1) == suffix) {
      stuck_n++
      stuck_ids[stuck_n] = fail_task[i]
    }
  }
  for (i = 1; i <= tdone_n; i++) {
    tid = tdone_ids[i]
    if (!(tid in task_tier)) continue
    tt = task_tier[tid]
    if (tt == "") continue
    if (!(tt in attempts_cnt)) {
      attempts_ocnt++
      attempts_ord[attempts_ocnt] = tt
      attempts_cnt[tt] = 0
    }
    attempts_cnt[tt]++
  }
  print "- Tasks done: " sprintf("%.0f", tdone_n)
  print "- Attempts per tier: " tier_list(attempts_cnt, attempts_ord, attempts_ocnt)
  print "- Resumes per tier: " tier_list(resumes_cnt, resumes_ord, resumes_ocnt)
  print "- Escalations per tier: " tier_list(esc_cnt, esc_ord, esc_ocnt)
  if (stuck_n > 0) {
    stuck_list = ""
    for (i = 1; i <= stuck_n; i++) {
      stuck_list = stuck_list (i > 1 ? ", " : "") stuck_ids[i]
    }
    print "- Tasks that ended STUCK: " sprintf("%.0f", stuck_n) " (" stuck_list ")"
  } else {
    print "- Tasks that ended STUCK: 0"
  }
  for (i = 1; i <= log_n; i++) {
    if (k > 0 && inv_of(log_epoch[i]) != k) continue
    lk = log_key[i]
    if (lk == "merge-resolved") {
      r++
    } else if (lk == "merge-rerun") {
      m++
    } else if (lk == "already-integrated") {
      a++
    } else if (lk == "containment-fallback") {
      cdown++
    } else if (lk == "auto-decided") {
      acnt++
      split(log_line[i], w2, " ")
      autoord[acnt] = w2[3] "\t" w2[4]
    } else if (lk == "background-warning") {
      wcnt++
      warnord[wcnt] = substr(log_line[i], length("background-warning ") + 1)
    }
  }
  f = m + a
  print "- Merges: " sprintf("%.0f", r) " resolved, " sprintf("%.0f", f) " failed (" sprintf("%.0f", m) " rerun, " sprintf("%.0f", a) " already integrated)"
  print "- Containment downgrades: " sprintf("%.0f", cdown)
  print "- Auto-decided questions: " sprintf("%.0f", acnt)
  for (j = 1; j <= acnt; j++) {
    split(autoord[j], w2, "\t")
    qid = w2[1]
    did = w2[2]
    if (did in dec_text) {
      txt = dec_text[did]
    } else {
      txt = did " (not in plan.md)"
    }
    print "  - " qid ": " txt
  }
  rf_ordn = 0
  for (i = 1; i <= rev_n; i++) {
    if (k > 0) {
      if (rev_epoch[i] == "") {
        if (k != n) continue
      } else {
        if (inv_of(rev_epoch[i] + 0) != k) continue
      }
    }
    rf_mid = rev_milestone[i]
    if (!(rf_mid in rf_seen)) {
      rf_seen[rf_mid] = 1
      rf_ordn++
      rf_ord[rf_ordn] = rf_mid
      rf_adv[rf_mid] = 0
      rf_conf[rf_mid] = 0
      rf_down[rf_mid] = 0
    }
    rf_adv[rf_mid] += rev_adv[i]
    rf_conf[rf_mid] += rev_conf[i]
    rf_down[rf_mid] += rev_down[i]
  }
  for (i = 2; i <= rf_ordn; i++) {
    rf_keyv = rf_ord[i]
    rf_keyn = milestone_num(rf_keyv)
    rf_j = i - 1
    while (rf_j >= 1 && milestone_num(rf_ord[rf_j]) > rf_keyn) {
      rf_ord[rf_j + 1] = rf_ord[rf_j]
      rf_j--
    }
    rf_ord[rf_j + 1] = rf_keyv
  }
  rf_any = 0
  rf_lines = ""
  for (i = 1; i <= rf_ordn; i++) {
    rf_mid = rf_ord[i]
    if (rf_adv[rf_mid] == 0 && rf_conf[rf_mid] == 0 && rf_down[rf_mid] == 0) continue
    rf_any = 1
    rf_lines = rf_lines "  - " rf_mid ": " sprintf("%.0f", rf_adv[rf_mid]) " advisory, " sprintf("%.0f", rf_conf[rf_mid]) " confirmed, " sprintf("%.0f", rf_down[rf_mid]) " downgraded\n"
  }
  print "- Review findings:" (rf_any ? "" : " none")
  if (rf_any) printf "%s", rf_lines
  print "- Leftover-background-work warnings: " sprintf("%.0f", wcnt)
  for (j = 1; j <= wcnt; j++) {
    print "  - " warnord[j]
  }
  if (k > 0) {
    if (inv_has_end[k] && (inv_mode[k] == "PAUSE" || inv_mode[k] == "STOP")) {
      list = inv_mode[k] " " inv_reason[k] " 1"
    } else {
      list = "none"
    }
    if (inv_has_end[k]) {
      val = sprintf("%.0f", int((inv_e[k] - inv_s[k]) / 60)) " min"
    } else {
      val = "unknown"
    }
  } else {
    ocount = 0
    sum = 0
    any_end = 0
    for (i = 1; i <= n; i++) {
      if (!inv_has_end[i]) continue
      any_end = 1
      sum += int((inv_e[i] - inv_s[i]) / 60)
      if (inv_mode[i] != "PAUSE" && inv_mode[i] != "STOP") continue
      key = inv_mode[i] " " inv_reason[i]
      if (!(key in count)) {
        ocount++
        order[ocount] = key
        count[key] = 0
      }
      count[key]++
    }
    if (ocount == 0) {
      list = "none"
    } else {
      list = ""
      for (j = 1; j <= ocount; j++) {
        if (j > 1) list = list ", "
        list = list order[j] " " sprintf("%.0f", count[order[j]])
      }
    }
    val = any_end ? (sprintf("%.0f", sum) " min") : "unknown"
  }
  print "- Stops and pauses: " list
  print "- Wall-clock time: " val
}
substr($0, 1, 1) == "L" {
  log_n++
  logline = substr($0, 3)
  log_line[log_n] = logline
  split(logline, w, " ")
  key = w[1]
  ts = w[2]
  log_key[log_n] = key
  log_epoch[log_n] = epoch(ts)
  if (key == "start") {
    e = epoch(ts)
    if (e >= 0) {
      n++
      inv_s_text[n] = ts
      inv_s[n] = e
      inv_has_end[n] = 0
    }
  } else if (key == "end") {
    e = epoch(ts)
    if (e >= 0 && n > 0 && !inv_has_end[n]) {
      reason = logline
      sub(/^[^ ]+ [^ ]+ [^ ]+ /, "", reason)
      inv_e[n] = e
      inv_mode[n] = w[3]
      inv_reason[n] = reason
      inv_has_end[n] = 1
    }
  }
}
substr($0, 1, 1) == "D" {
  drest = substr($0, 3)
  did = drest
  sub(/:.*/, "", did)
  dec_text[did] = drest
}
substr($0, 1, 1) == "T" {
  task_n++
  task_id_ord[task_n] = $2
  task_status[$2] = $3
  task_tier[$2] = $4
}
substr($0, 1, 1) == "C" {
  commit_n++
  commit_epoch[commit_n] = $2 + 0
  commit_task[commit_n] = $3
}
substr($0, 1, 1) == "F" {
  fail_n++
  fail_time[fail_n] = $2
  fail_task[fail_n] = $3
  fail_tier[fail_n] = $4
  fail_then[fail_n] = $5
}
substr($0, 1, 1) == "R" {
  rev_n++
  rev_epoch[rev_n] = $2
  rev_milestone[rev_n] = $3
  rev_adv[rev_n] = $4 + 0
  rev_conf[rev_n] = $5 + 0
  rev_down[rev_n] = $6 + 0
}
substr($0, 1, 1) == "S" {
  sugg_n++
  sugg_category[sugg_n] = $2
  sugg_kind[sugg_n] = $3
  sugg_target[sugg_n] = $4
}
function usage_line(k, label,    i, w2, tok_sum, ms_sum, cnt, ord, ocnt, agent, j, atok, oms) {
  tok_sum = 0
  ms_sum = 0
  cnt = 0
  ocnt = 0
  for (i = 1; i <= log_n; i++) {
    if (log_key[i] != "usage") continue
    split(log_line[i], w2, " ")
    if (w2[5] !~ /^[0-9]+$/) continue
    if (k > 0 && inv_of(log_epoch[i]) != k) continue
    cnt++
    tok_sum += w2[5] + 0
    ms_sum += w2[6] + 0
    agent = w2[4]
    if (!(agent in atok)) {
      ocnt++
      ord[ocnt] = agent
      atok[agent] = 0
      oms[agent] = 0
    }
    atok[agent] += w2[5] + 0
    oms[agent] += w2[6] + 0
  }
  if (cnt == 0) {
    print "- " label ": not available"
    return
  }
  print "- " label ": " sprintf("%.0f", tok_sum) " tokens, " sprintf("%.0f", int(ms_sum / 60000)) " min of agent time"
  for (j = 1; j <= ocnt; j++) {
    print "  - " ord[j] ": " sprintf("%.0f", atok[ord[j]]) " tokens, " sprintf("%.0f", int(oms[ord[j]] / 60000)) " min"
  }
}
END {
  printf "# Run report: %s\n\n", title
  for (k = 1; k <= n; k++) {
    printf "## Invocation %d: %s\n\n", k, inv_s_text[k]
    bullets(k)
    print ""
  }
  print "## Plan so far"
  print ""
  bullets(0)
  print ""
  print "## Usage"
  print ""
  usage_total = 0
  for (i = 1; i <= log_n; i++) {
    if (log_key[i] != "usage") continue
    split(log_line[i], w2, " ")
    if (w2[5] !~ /^[0-9]+$/) continue
    usage_total++
  }
  if (usage_total == 0) {
    print "not available"
  } else {
    for (k = 1; k <= n; k++) {
      usage_line(k, "Invocation " k)
    }
    usage_line(0, "Plan so far")
  }
  print ""
  print "## Model notices"
  print ""
  notice_n = 0
  for (i = 1; i <= log_n; i++) {
    if (log_key[i] != "model-notice") continue
    notice_n++
    print "- " substr(log_line[i], length("model-notice ") + 1)
  }
  if (notice_n == 0) print "None."
  print ""
  print "## Suggestions"
  print ""
  if (sugg_n == 0) {
    print "None."
  } else {
    for (i = 1; i <= sugg_n; i++) {
      print "- " sugg_category[i] ": " sugg_kind[i] ", target " sugg_target[i]
    }
  }
}'

notes_dir="$plan_dir/notes"
mkdir -p "$notes_dir" || fail "cannot create: $(print_path "$notes_dir")"
report="$notes_dir/run-report.md"
tmp="$report.tmp"

printf '%s\n' "$records" | awk -F '\t' -v title="$title" "$report_awk" > "$tmp"

mv -f "$tmp" "$report" || fail "cannot write the report: $(print_path "$report")"

notes_abs=$(cd "$notes_dir" && pwd) || fail "cannot resolve: $(print_path "$notes_dir")"
print_path "$notes_abs/run-report.md"
exit 0
