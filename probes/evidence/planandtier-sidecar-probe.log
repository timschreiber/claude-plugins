\n    status: { type: 'string', enum: ['done', 'failed'] },\\n    summary: { type: 'string' },\\n    filesChanged: { type: 'array', items: { type: 'string' } },\\n  },\\n}\\n\\nconst results = []\\nfor (const task of tasks) {\\n  phase(`${task.id}: ${task.title}`)\\n  let result\\n  try {\\n    result = await agent(task.prompt, {\\n      label: task.id,\\n      model: task.model,\\n      effort: task.effort,\\n      agentType: 'planandtier:worker',\\n      schema: resultSchema,\\n    })\\n  } catch (e) {\\n    result = { status: 'failed', summary: `The task threw: ${String(e)}` }\\n  }\\n  results.push({ id: task.id, ...(result ?? { status: 'stopped', summary: 'The task was stopped or its subagent failed.' }) })\\n  if (!result || result.status !== 'done') {\\n    log(`Halting at ${task.id}`)\\n    return { status: 'halted', at: task.id, results }\\n  }\\n}\\nreturn { status: 'complete', results }\\n\"},\"tool_response\":{\"status\":\"async_launched\",\"taskId\":\"wag2bsgt4\",\"taskType\":\"local_workflow\",\"workflowName\":\"execute-plan\",\"runId\":\"wf_37f80f18-c3e\",\"summary\":\"Run an approved planandtier plan one task at a time, each at its tagged model and effort\",\"transcriptDir\":\"C:\\\\Users\\\\timsc\\\\.claude\\\\projects\\\\C--Users-timsc-AppData-Local-Temp-tier-sidecar\\\\249d0737-32ab-4e27-a572-2d564bb91b7d\\\\subagents\\\\workflows\\\\wf_37f80f18-c3e\",\"scriptPath\":\"C:\\\\Users\\\\timsc\\\\.claude\\\\projects\\\\C--Users-timsc-AppData-Local-Temp-tier-sidecar\\\\249d0737-32ab-4e27-a572-2d564bb91b7d\\\\workflows\\\\scripts\\\\execute-plan-wf_37f80f18-c3e.js\"},\"tool_use_id\":\"toolu_01M4NhpqoALWsM4YimD6WKam\",\"duration_ms\":5}\n"}
