{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/probe.js\" ups", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/probe.js\" pre-agent", "timeout": 15 }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|Read",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/probe.js\" pre-tool", "timeout": 15 }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/mkwt.js\"", "timeout": 30 }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit|Read|Glob|Grep",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.js\"", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/probe.js\" post-agent", "timeout": 15 }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|Read",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/probe.js\" post-tool", "timeout": 15 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task|Bash|Write|Edit|Read",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/probe.js\" post-fail", "timeout": 15 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/probe.js\" perm-request", "timeout": 15 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/probe.js\" sub-start", "timeout": 15 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/probe.js\" sub-stop", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/probe.js\" stop", "timeout": 15 }
        ]
      }
    ]
  }
}
